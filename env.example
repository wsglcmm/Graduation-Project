# Copy this file to .env (same folder) and fill in your key. Never commit .env.
# Which LLM to use: gemini (default) or anthropic
AGENT_PROVIDER=gemini
# Gemini API key from Google AI Studio
GEMINI_API_KEY=your-gemini-api-key-here
# Only needed if AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Lower thinking level = lower latency (minimal / low / medium / high)
AGENT_THINKING=minimal
# Optional:
# AGENT_MODEL=gemini-3.1-flash-lite
# AGENT_FALLBACK_MODELS=gemini-3.5-flash-lite
# AGENT_TIMEOUT_S=10
